# Local geliştirme örneği; üretimde kullanmayın.
POSTGRES_DB=doping_kesif
POSTGRES_USER=kesif_local
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
SERVER_PORT=8080
# İsteğe bağlı local ayarlar. Süreler onaylı ürün kuralı değil, demo örneğidir.
KESIF_ROOM_TTL=PT5M
KESIF_INVITATION_TTL=PT2M
KESIF_QUESTION_DURATION=PT30S
KESIF_REVEAL_DURATION=PT10S
# Provisional local demo rewards; change only after product policy review.
KESIF_REWARDS_ENABLED=true
KESIF_COMPLETION_XP=10
KESIF_CORRECT_ANSWER_XP=2
KESIF_COLLECTION_COMPLETION_XP=50
KESIF_COLLECTION_MAPPING=SHARED_UNION
# Local'de boş bırakılırsa bellek içi anahtar kullanılır; restart açık kodlu odaları sonlandırır.
# Kalıcı kullanımda rastgele en az 32 byte verinin Base64 karşılığını sağlayın. Üretimde zorunlu.
ROOM_CODE_SECRET=
